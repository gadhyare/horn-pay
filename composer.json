{
    "name": "gadhyare/horn-pay",
    "description": "A Laravel package for mobile money payments in the Horn of Africa.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Gadhyare",
            "email": "gadhyare@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Gadhyare\\HornPay\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gadhyare\\HornPay\\HornPayServiceProvider"
            ],
            "aliases": {
                "HornPay": "Gadhyare\\HornPay\\Facades\\HornPay"
            }
        }
    }
}